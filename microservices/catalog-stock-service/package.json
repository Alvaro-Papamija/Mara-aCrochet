{
  "name": "marana-catalog-stock-service",
  "version": "1.0.0",
  "description": "Microservicio independiente de Catálogo de Amigurumis y Control de Stock para Maraña Crochet",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "docker:build": "docker build -t marana-catalog-stock-service .",
    "docker:run": "docker run -p 3001:3001 --name marana-catalog-stock marana-catalog-stock-service"
  },
  "keywords": [
    "microservices",
    "express",
    "typescript",
    "catalog",
    "inventory",
    "crochet",
    "marana"
  ],
  "author": "Maraña Crochet Atelier",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
